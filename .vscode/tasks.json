{
	"version": "2.0.0",

	"tasks": [
		{
			"label": "build-market-price-api",
			"command": "dotnet",
			"type": "process",

			"args": [
				"build",
				"${config:csp.marketPriceApi}",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],

			"problemMatcher": "$msCompile"
		},

		{
			"label": "start-mongo-db",
			"type" : "process",

			"isBackground": true,
			"command" : "mongod",

			"args" : [
				"--dbpath", "${config:mongodb.data}",
				"--port"  , "${config:mongodb.port}",
				"${input:auth}", "--quiet"
			],
		}
	],

	"inputs": [
		{
			"id": "auth",
			"description": "Select authentification flag",

			"type": "pickString",
			"options": [
				"--auth"  ,
				"--noauth"
			]
		}
	]
}